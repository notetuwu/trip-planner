# Personal data: your trips, imported place lists, lookup caches and API keys stay on your machine.
# (Anchored with "/" so code folders with the same names, like web/src/saves/ or server/lists/, are kept.)
/saves/
/lists/
/cache/
/keys.json
/settings.json
# Drive sync: the Google sign-in token, what's synced, and copies of the folders' trips.
/sync/
# The settings (with a secret key) of the SearXNG the app sets up.
/searxng/
*.csv

# Old versions and local clutter
/backup-v1/
node_modules/
.env
.DS_Store
Thumbs.db

# Build output
/dist/

# Packaged app (npm run package)
/release/

current-trip.json
