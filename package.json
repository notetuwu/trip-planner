{
  "name": "local-trip-planner",
  "version": "3.2.10",
  "private": true,
  "description": "Day-by-day itinerary planner that runs locally with Claude Code or a local model.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr server/main.ts --outDir dist/server --emptyOutDir",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "test": "node scripts/test.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "leaflet": "^1.9.4",
    "lucide": "^1.77.0",
    "opening_hours": "^3.16.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
